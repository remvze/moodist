---
import { Container } from './container';
---

<footer class="footer">
  <Container>
    <p>
      Created by <a href="https://www.theworkdocs.com/">The Work Docs team</a>
    </p>
  </Container>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    padding: 36px 0 44px;
    text-align: center;

    & p {
      font-size: var(--font-sm);
      color: var(--color-foreground-subtle);
      text-align: center;

      & a {
        font-weight: 500;
        color: var(--color-foreground);
        text-decoration: none;
      }
    }

    & a:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    & a:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 4px;
      border-radius: 4px;
    }
  }
</style>
