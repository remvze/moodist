---
import { BsArrowUpRight } from 'react-icons/bs/index';
import { Container } from './container';
---

<section aria-labelledby="workdocs-title" class="workdocs-promo" id="workdocs">
  <Container>
    <div class="intro">
      <div class="copy">
        <h2 id="workdocs-title">The Work Docs</h2>
        <p>Read PDFs, ask questions, and keep your notes together.</p>
      </div>
      <a
        aria-label="Explore The Work Docs (opens in a new tab)"
        class="action"
        href="https://www.theworkdocs.com/"
        rel="noopener noreferrer"
        target="_blank"
      >
        Explore The Work Docs <BsArrowUpRight aria-hidden="true" />
      </a>
    </div>
  </Container>
</section>

<style>
  .workdocs-promo {
    padding: 4px 0 32px;
    scroll-margin-top: 24px;
  }

  .intro {
    display: flex;
    gap: 20px 32px;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 28px;
    border-bottom: 1px solid var(--color-border);
  }

  .copy {
    & h2 {
      font-size: 18px;
      font-weight: 450;
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    & p {
      max-width: 400px;
      margin-top: 6px;
      font-size: var(--font-sm);
      line-height: 1.6;
      color: var(--color-foreground-subtle);
    }
  }

  .action {
    display: inline-flex;
    flex: none;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-sm);
    font-weight: 450;
    color: var(--color-accent);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 5px;
      border-radius: 4px;
    }
  }

  @media (width <= 600px) {
    .workdocs-promo {
      padding-bottom: 20px;
    }

    .intro {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
      padding: 12px 0 22px;
    }
  }
</style>
